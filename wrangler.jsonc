{
  "name": "bankfile-analyse",
  "main": "worker/index.js",
  "keep_vars": true ,
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [{ "binding": "DB", "database_name": "bankoverzicht-rechten", "database_id": "391e8408-d381-46bc-af6a-f49bb03f7a7e" }],
"mtls_certificates": [{ "binding": "PONTO_CERT", "certificate_id": "6f3106bd-cc5a-4f62-a89e-259188482c97" }],
  "vars": {
    "BANKKOPPELING": "beheerders",
    "BEHEERDERS": "paul@paulgerits.eu",
    "FEEDBACK_TO": "paul@paulgerits.eu",
    "FEEDBACK_FROM": "feedback@bankafschriftentool.app",
    "BEHEERDERS": "paul@paulgerits.eu",
    "TOEGANG_VERPLICHT": "ja",
    "INLOG_MODUS": "eigen",
    "INLOG_FROM": "inloggen@bankafschriftentool.app",                         
    "BANK_AANBIEDER": "ponto",
    "PONTO_OMGEVING": "sandbox",
    }
  }
 }