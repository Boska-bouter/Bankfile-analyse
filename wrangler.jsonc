{
  "name": "bankfile-analyse",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "previews": {
    "send_email": [{ "name": "EMAIL" }],
    "d1_databases": [{ "binding": "DB", "database_name": "bankoverzicht-rechten", "database_id": "391e8408-d381-46bc-af6a-f49bb03f7a7e" }],
    "vars": {
      "FEEDBACK_TO": "paul@paulgerits.eu",
      "FEEDBACK_FROM": "feedback@bankafschriftentool.app",
      "BEHEERDERS": "paul@paulgerits.eu",
      "TOEGANG_VERPLICHT": "ja",
      "INLOG_MODUS": "eigen",
      "INLOG_FROM": "inloggen@bankafschriftentool.app"
    }
  }
}
