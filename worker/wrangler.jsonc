{
  "name": "bankoverzicht-feedback",
  "main": "index.js",
  "compatibility_date": "2025-10-01",
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "FEEDBACK_TO": "paul@paulgerits.eu",
    "FEEDBACK_FROM": "feedback@paulgerits.eu"
  },
  // Zet hier de hostnaam waarop de app draait (achter Cloudflare Access), bijvoorbeeld "bankoverzicht.paulgerits.eu".
  "routes": [{ "pattern": "VUL-HIER-DE-HOSTNAAM-VAN-DE-APP-IN/api/feedback*", "zone_name": "paulgerits.eu" }]
}
